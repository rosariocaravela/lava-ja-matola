PORT=5000
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
DB_PATH=./lavaja.db

# Opcional: Chave de API de IA para modelo generativo externo (Gemini ou OpenAI).
# Quando omitido, o Lava Já AI opera no modo Assistente Demonstrativo Local inteligente sem custos de API.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Recuperação segura de palavra-passe por email (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CLIENT_PUBLIC_URL=http://localhost:3000

# Moza Banco não possui integração oficial configurada neste projeto.
# Mantenha ambos desativados até existir integração e aprovação comercial.
# Ativação apenas para testes locais da simulação:
MOZABANCO_SIMULATION_ENABLED=false
MOZABANCO_DISCOUNT_ENABLED=false

# Campanha de fidelização Moza. Apenas aceite eventos enviados por um adaptador
# oficial autorizado. Não configure uma chave fictícia para produção.
MOZA_BENEFIT_TRANSACTION_TARGET=5
MOZA_BENEFIT_DISCOUNT_PERCENTAGE=10
MOZA_BENEFIT_MIN_TRANSACTION_MZN=1
# 0 significa sem validade; um valor positivo define dias após desbloqueio.
MOZA_BENEFIT_VALIDITY_DAYS=0
# Segredo aleatório com pelo menos 32 bytes, partilhado apenas com o adaptador autorizado.
MOZA_TRANSACTION_WEBHOOK_SECRET=
