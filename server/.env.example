PORT=5000
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
DB_PATH=./lavaja.db

# Opcional: Chave de API de IA para modelo generativo externo (Gemini ou OpenAI).
# Quando omitido, o Lava Já AI opera no modo Assistente Demonstrativo Local inteligente sem custos de API.
GEMINI_API_KEY=
OPENAI_API_KEY=
